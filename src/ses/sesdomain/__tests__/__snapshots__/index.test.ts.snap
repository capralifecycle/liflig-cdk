        "lifligcdksesdomainproviderFunctionServiceRole4F119253",
      ],
      "Properties": {
        "Code": Any<Object>,
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "lifligcdksesdomainproviderFunctionServiceRole4F119253",
            "Arn",
          ],
        },
        "Runtime": "nodejs24.x",
        "Timeout": 300,
      },
      "Type": "AWS::Lambda::Function",
    },
    "lifligcdksesdomainproviderFunctionServiceRole4F119253": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com",
              },
            },
          ],
