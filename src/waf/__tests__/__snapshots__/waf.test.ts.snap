                  },
                },
              ],
              "Requirement": "MEETS_ANY",
            },
          ],
        },
        "RedactedFields": [
          {
            "SingleHeader": {
              "Name": "authorization",
            },
          },
          {
            "SingleHeader": {
              "Name": "cookie",
            },
          },
        ],
